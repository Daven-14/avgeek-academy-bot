# Copy to .env and fill in. Never commit .env.

TELEGRAM_BOT_TOKEN=123456:ABC-replace-with-your-token

# Telegram Stars price for AvGeek Pro (30 days). Currency is XTR.
PREMIUM_STARS_PRICE=150

# Comma-separated Telegram user ids that always get premium (owners / testers).
PREMIUM_BYPASS_USER_IDS=

# If set, bot runs in webhook mode instead of polling.
# Example: https://your-app.up.railway.app
WEBHOOK_URL=
# Listen port inside the container (Railway/Fly set PORT automatically).
PORT=8080
# Path appended to WEBHOOK_URL. Default: /telegram
WEBHOOK_PATH=/telegram

# Daily lesson push (UTC hour, 0-23). Default 9 = 09:00 UTC.
DAILY_LESSON_HOUR=9
